              "type": "string"
            },
            "text": {
              "title": "Text",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "title": "TextEvidence",
          "type": "object"
        },
        "TextPathEvidence": {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "text_path",
              "title": "Type",
              "type": "string"
            },
            "path": {
              "minLength": 1,
              "title": "Path",
              "type": "string"
            }
          },
          "required": [
            "type",
            "path"
